# Files that must never be served to a visitor.
# Anything listed here still deploys with the Worker, it just is not
# reachable over HTTP — which matters most for lib/, since that is where the
# GitHub publishing code lives.

node_modules/
.wrangler/
.git/
package-lock.json
npm-debug.log

worker.mjs
wrangler.jsonc
wrangler.toml
.assetsignore
.gitignore
.env
.env.example
PASSCODE.txt

lib/
api/
functions/
tools/
dev-server.mjs

package.json
vercel.json
README.md
DEPLOY.md
CLIENT-GUIDE.md

# _headers must NOT be listed here.
# Cloudflare never serves it to visitors anyway — it reads the file and
# applies its rules to the static asset responses. Excluding it means
# Cloudflare never receives it, so the cache and security headers silently
# stop working. Same applies to _redirects if you ever add one.