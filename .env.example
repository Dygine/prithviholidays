# Copy to .env for local testing with dev-server.mjs, or set these in your
# host's dashboard (Cloudflare Pages / Vercel → Settings → Environment variables).
#
# NEVER commit a real token. .gitignore already excludes .env.

# Fine-grained personal access token.
# Repository access: ONLY this repository.
# Permissions: Contents → Read and write. Nothing else.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# owner/repository
GITHUB_REPO=your-username/prithvi-holidays

# Optional, defaults to main
GITHUB_BRANCH=main

# The admin password. Make it long.
ADMIN_PASSWORD=change-this-to-something-long
